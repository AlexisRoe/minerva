__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
ENV/
env/

# Type checkers & linters
.mypy_cache/
.ruff_cache/
.pytype/

# Python packaging & distribution
.eggs/
*.egg-info/
*.egg

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.local
.env.*.local
# Timestamped .env backups created by scripts/initial-setup.sh (.env.20260727-134500)
.env.[0-9]*
.env.*.[0-9]*
!.env.example

# ==========================================
# Local TLS certificates (mkcert)
# ==========================================
infra/cert/

