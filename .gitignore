# ============================================================
# Backend — Python
# ============================================================
backend/__pycache__/
backend/**/__pycache__/
backend/build/
backend/dist/
backend/*.egg-info/
backend/.eggs/
backend/wheels/

# Virtual environments
backend/.venv/
backend/venv/
backend/env/
.venv/
venv/

# Testing / coverage
backend/.pytest_cache/
backend/.tox/
backend/.nox/
backend/.coverage
backend/.coverage.*
backend/coverage.xml
backend/htmlcov/
backend/.hypothesis/

# Type checkers / linters
backend/.mypy_cache/
backend/.dmypy.json
backend/.ruff_cache/
backend/.pyre/
backend/.pytype/

# Django / Flask (remove if unused)
backend/db.sqlite3
backend/db.sqlite3-journal
backend/instance/
backend/local_settings.py

# Jupyter
backend/.ipynb_checkpoints/

# Catch-all for compiled Python anywhere
*.py[cod]
*$py.class
*.so

# ============================================================
# Frontend — Node / React
# ============================================================
frontend/node_modules/
frontend/.pnp
frontend/.pnp.js

# Production builds
frontend/build/
frontend/dist/
frontend/.next/
frontend/out/

# Caches
frontend/.eslintcache
frontend/.parcel-cache/
frontend/.cache/
frontend/*.tsbuildinfo

# Debug logs
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# ============================================================
# Environment variables (root + both folders)
# ============================================================
.env
.env.*
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
!.env.example
!backend/.env.example
!frontend/.env.example

