<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
    xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
    xsi:type="MailApp">

  <!-- Microsoft application id (GUID) as uuid v4 -->
  <Id>{{GUID}}</Id>
  <!-- Application version needs to be increased with each deployment -->
  <Version>1.0.0.0</Version>
  <ProviderName>Minerva</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>

  <!--
    DisplayName / Description here are the fixed, non-localizable fallback
    shown to very old Outlook clients that don't understand <VersionOverrides>.
    The XML add-in-only manifest does not support localizing DisplayName at
    all (a known platform limitation); Description IS localized for modern
    clients via the resid-based override inside VersionOverrides below.
  -->
  <DisplayName DefaultValue="Minerva" />
  <Description DefaultValue="Report suspicios or spam emails for further investigation and help increasing security in your company" />

  <IconUrl DefaultValue="https://{{deployed-domain}}/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://{{deployed-domain}}/assets/icon-64.png" />
  <SupportUrl DefaultValue="{{url-to-be-displayed-in-addon-interface}}/support.html" />

  <AppDomains>
    <!-- Needed for interactive NAA fallback (acquireTokenPopup) sign-in UX. -->
    <AppDomain>https://login.microsoftonline.com</AppDomain>
    <AppDomain>https://login.live.com</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <!--
    Fallback requirement gate for clients that support the add-in-only
    manifest but NOT the <VersionOverrides> element at all. Kept low so the
    add-in still loads (with a plain read-form pane, no commands) on very
    old clients; the real, feature-rich experience below requires 1.13.
  -->
  <Requirements>
    <Sets DefaultMinVersion="1.3">
      <Set Name="Mailbox" MinVersion="1.3" />
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://{{deployed-domain}}" />
        <!-- Minimum taskpane height in pixel -->
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <!--
    Office.js API permission level (this governs Office.js calls such as
    reading item properties; it is separate from the Microsoft Graph
    permissions below, which are governed by the Entra ID app registration
    and consented scopes). ReadWriteMailbox is the broadest level and covers
    reading the open item plus any local Office.js mailbox operations.
  -->
  <Permissions>ReadWriteMailbox</Permissions>

  <!-- Activate only for email messages, only in Read mode - never Compose. -->
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
  </Rule>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">

    <Description resid="App.Description" />

    <Requirements>
      <Sets DefaultMinVersion="1.3">
        <Set Name="Mailbox" MinVersion="1.3" />
      </Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Function.Url" />

          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="msgReadGroup">
                <Label resid="Group.Label" />
                <Icon>
                  <bt:Image size="16" resid="icon16" />
                  <bt:Image size="32" resid="icon32" />
                  <bt:Image size="80" resid="icon80" />
                </Icon>
                <Control xsi:type="Button" id="msgReadOpenPaneButton">
                  <Label resid="TaskpaneButton.Label" />
                  <Supertip>
                    <Title resid="Taskpane.Tooltip" />
                    <Description resid="Taskpane.Description" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16" />
                    <bt:Image size="32" resid="icon32" />
                    <bt:Image size="80" resid="icon80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>msgReadTaskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>

          <!--
            Enables the add-in on delegate shared folders (req. set 1.8+)
            and shared mailboxes (req. set 1.13+, declared in the nested
            VersionOverrides 1.1 block below, which is what actually governs
            this on the clients that matter here).
          -->
          <SupportsSharedFolders>true</SupportsSharedFolders>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="icon16" DefaultValue="https://{{deployed-domain}}/assets/icon-16.png" />
        <bt:Image id="icon32" DefaultValue="https://{{deployed-domain}}/assets/icon-32.png" />
        <bt:Image id="icon80" DefaultValue="https://{{deployed-domain}}/assets/icon-80.png" />
        <bt:Image id="icon25" DefaultValue="https://{{deployed-domain}}/assets/icon-25.png" />
        <bt:Image id="icon48" DefaultValue="https://{{deployed-domain}}/assets/icon-48.png" />
      </bt:Images>

      <bt:Urls>
        <bt:Url id="Function.Url" DefaultValue="https://{{deployed-domain}}" />
        <bt:Url id="Taskpane.Url" DefaultValue="https://{{deployed-domain}}" />
      </bt:Urls>

      <bt:ShortStrings>
        <bt:String id="Group.Label" DefaultValue="Minerva" />

        <bt:String id="TaskpaneButton.Label" DefaultValue="Open Reporting Button">
          <bt:Override Locale="de-DE" Value="Meldeschaltfläche öffnen" />
          <bt:Override Locale="fr-FR" Value="Ouvrir le bouton de signalement" />
          <bt:Override Locale="nl-NL" Value="Meldknop openen" />
          <bt:Override Locale="es-ES" Value="Abrir botón de informes" />
          <bt:Override Locale="pt-PT" Value="Abrir botão de denúncia" />
          <bt:Override Locale="pt-BR" Value="Abrir botão de denúncia" />
        </bt:String>

        <bt:String id="Taskpane.Tooltip" DefaultValue="Open Reporting Button">
          <bt:Override Locale="de-DE" Value="Meldeschaltfläche öffnen" />
          <bt:Override Locale="fr-FR" Value="Ouvrir le bouton de signalement" />
          <bt:Override Locale="nl-NL" Value="Meldknop openen" />
          <bt:Override Locale="es-ES" Value="Abrir botón de informes" />
          <bt:Override Locale="pt-PT" Value="Abrir botão de denúncia" />
          <bt:Override Locale="pt-BR" Value="Abrir botão de denúncia" />
        </bt:String>
      </bt:ShortStrings>

      <bt:LongStrings>
        <bt:String id="App.Description" DefaultValue="Report suspicious or spam emails to your security department for further investigation. Help to increase security of your company.">
          <bt:Override Locale="de-DE" Value="Melden Sie verdächtige E-Mails oder Spam an Ihre Sicherheitsabteilung zur weiteren Untersuchung. Tragen Sie dazu bei, die Sicherheit Ihres Unternehmens zu erhöhen." />
          <bt:Override Locale="fr-FR" Value="Signalez les e-mails suspects ou indésirables à votre service de sécurité pour une enquête plus approfondie. Contribuez à renforcer la sécurité de votre entreprise." />
          <bt:Override Locale="nl-NL" Value="Meld verdachte of spam-e-mails aan uw beveiligingsafdeling voor verder onderzoek. Help de veiligheid van uw bedrijf te vergroten." />
          <bt:Override Locale="es-ES" Value="Informe de correos electrónicos sospechosos o no deseados a su departamento de seguridad para su posterior investigación. Ayude a aumentar la seguridad de su empresa." />
          <bt:Override Locale="pt-PT" Value="Reporte e-mails suspeitos ou de spam ao seu departamento de segurança para investigação adicional. Ajude a aumentar a segurança da sua empresa." />
          <bt:Override Locale="pt-BR" Value="Relate e-mails suspeitos ou spam ao seu departamento de segurança para investigação adicional. Ajude a aumentar a segurança da sua empresa." />
        </bt:String>

        <bt:String id="Taskpane.Description" DefaultValue="Report suspicious or spam emails to your security department for further investigation. Help to increase security of your company.">
          <bt:Override Locale="de-DE" Value="Melden Sie verdächtige E-Mails oder Spam an Ihre Sicherheitsabteilung zur weiteren Untersuchung. Tragen Sie dazu bei, die Sicherheit Ihres Unternehmens zu erhöhen." />
          <bt:Override Locale="fr-FR" Value="Signalez les e-mails suspects ou indésirables à votre service de sécurité pour une enquête plus approfondie. Contribuez à renforcer la sécurité de votre entreprise." />
          <bt:Override Locale="nl-NL" Value="Meld verdachte of spam-e-mails aan uw beveiligingsafdeling voor verder onderzoek. Help de veiligheid van uw bedrijf te vergroten." />
          <bt:Override Locale="es-ES" Value="Informe de correos electrónicos sospechosos o no deseados a su departamento de seguridad para su posterior investigación. Ayude a aumentar la seguridad de su empresa." />
          <bt:Override Locale="pt-PT" Value="Reporte e-mails suspeitos ou de spam ao seu departamento de segurança para investigação adicional. Ajude a aumentar a segurança da sua empresa." />
          <bt:Override Locale="pt-BR" Value="Relate e-mails suspeitos ou spam ao seu departamento de segurança para investigação adicional. Ajude a aumentar a segurança da sua empresa." />
        </bt:String>
      </bt:LongStrings>
    </Resources>

    <!--
      ==========================================================================
      Nested VersionOverrides 1.1 - the block that actually governs modern
      clients (Windows, Mac, web/OWA, and mobile). This is where:
        - the effective Mailbox 1.13 requirement lives (full shared-mailbox
          support, superset of 1.8 shared-folder support),
        - the Mobile read-command-surface is declared,
        - shared folders are (re)confirmed for this tier.
      It reuses the single <Resources> block defined above - resource ids
      are shared across the whole manifest, so no strings/icons/urls need to
      be duplicated here for Mobile vs. Desktop, or for Windows vs Mac vs OWA.
      ==========================================================================
    -->
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">

      <Requirements>
        <Sets DefaultMinVersion="1.13">
          <Set Name="Mailbox" MinVersion="1.13" />
        </Sets>
      </Requirements>

      <Hosts>
        <Host xsi:type="MailHost">

          <DesktopFormFactor>
            <FunctionFile resid="Function.Url" />

            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="msgReadGroup11">
                  <Label resid="Group.Label" />
                  <Icon>
                    <bt:Image size="16" resid="icon16" />
                    <bt:Image size="32" resid="icon32" />
                    <bt:Image size="80" resid="icon80" />
                  </Icon>
                  <Control xsi:type="Button" id="msgReadOpenPaneButton11">
                    <Label resid="TaskpaneButton.Label" />
                    <Supertip>
                      <Title resid="Taskpane.Tooltip" />
                      <Description resid="Taskpane.Description" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="icon16" />
                      <bt:Image size="32" resid="icon32" />
                      <bt:Image size="80" resid="icon80" />
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <TaskpaneId>msgReadTaskpane</TaskpaneId>
                      <SourceLocation resid="Taskpane.Url" />
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>

            <!-- Full shared-folder (1.8+) AND shared-mailbox (1.13+) support. -->
            <SupportsSharedFolders>true</SupportsSharedFolders>
          </DesktopFormFactor>

          <!--
            Outlook mobile (iOS/Android). Per Microsoft guidance,
            MobileMessageReadCommandSurface is the only extension point that
            should be declared for a standard read-mode add-in - there is no
            compose-mode equivalent, which keeps this add-in read-only on
            mobile automatically.
          -->
          <MobileFormFactor>
            <FunctionFile resid="Function.Url" />
            <ExtensionPoint xsi:type="MobileMessageReadCommandSurface">
              <Group id="mobileMsgReadGroup">
                <Label resid="Group.Label" />
                <Control xsi:type="MobileButton" id="mobileOpenPaneButton">
                  <Label resid="TaskpaneButton.Label" />
                  <Icon xsi:type="bt:MobileIconList">
                    <bt:Image size="25" scale="1" resid="icon25" />
                    <bt:Image size="25" scale="2" resid="icon25" />
                    <bt:Image size="25" scale="3" resid="icon25" />
                    <bt:Image size="32" scale="1" resid="icon32" />
                    <bt:Image size="32" scale="2" resid="icon32" />
                    <bt:Image size="32" scale="3" resid="icon32" />
                    <bt:Image size="48" scale="1" resid="icon48" />
                    <bt:Image size="48" scale="2" resid="icon48" />
                    <bt:Image size="48" scale="3" resid="icon48" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </ExtensionPoint>
          </MobileFormFactor>

        </Host>
      </Hosts>

    </VersionOverrides>

    <!--
      ==========================================================================
      WebApplicationInfo — registers this add-in's Microsoft Entra ID app for
      SSO/NAA and surfaces the Microsoft Graph permissions it needs so admins
      can review/consent to them centrally (e.g. via Microsoft 365 admin
      center deployment). This does NOT itself enable NAA — NAA is enabled by
      your task pane code calling createNestablePublicClientApplication()
      from @azure/msal-browser with this same client ID, after your app is
      registered in Azure/Entra with a "brk-multihub://<your-add-in-domain>"
      Single-Page-Application redirect URI. See:
      https://learn.microsoft.com/office/dev/add-ins/develop/enable-nested-app-authentication-in-your-add-in

      TODO: replace <Id> with your Entra app's Application (client) ID, and
      <Resource> with that app's Application ID URI (api://<domain>/<client-id>).
      Must be the LAST child element of this VersionOverrides block.
      ==========================================================================
    -->
    <WebApplicationInfo>
      <Id>{{Graph-API-CLIENT-ID-AS-UUID}}</Id>
      <Resource>api://{{deployed-domain}}/{{Graph-API-CLIENT-ID-AS-UUID}}</Resource>
      <Scopes>
        <!-- Sign-in / basic identity -->
        <Scope>openid</Scope>
        <Scope>profile</Scope>
        <Scope>offline_access</Scope>
        <!-- Basic user information -->
        <Scope>User.Read</Scope>
        <!-- Read/write/send/delete/move mail in the signed-in user's own mailbox -->
        <Scope>Mail.Read</Scope>
        <Scope>Mail.ReadWrite</Scope>
        <Scope>Mail.Send</Scope>
        <!-- Same actions in shared folders / shared mailboxes the user has delegate access to -->
        <Scope>Mail.Read.Shared</Scope>
        <Scope>Mail.ReadWrite.Shared</Scope>
        <Scope>Mail.Send.Shared</Scope>
      </Scopes>
    </WebApplicationInfo>

  </VersionOverrides>

</OfficeApp>
