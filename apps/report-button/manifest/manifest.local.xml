        <bt:Image id="icon48" DefaultValue="https://localhost:5174/assets/icon-48.png" />
      </bt:Images>

      <bt:Urls>
        <bt:Url id="Function.Url" DefaultValue="https://localhost:5174" />
        <bt:Url id="Taskpane.Url" DefaultValue="https://localhost:5174" />
      </bt:Urls>

      <bt:ShortStrings>
