    xsi:type="MailApp">

  <Id>7AFD60CC-E876-49CF-BB4E-6ED97E6C699E</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Minerva</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>


  <DisplayName DefaultValue="Minerva" />
  <Description DefaultValue="Report suspicios or spam emails for further investigation and help increasing security in your company" />

  <IconUrl DefaultValue="https://localhost:5174/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://localhost:5174/assets/icon-64.png" />
  <SupportUrl DefaultValue="https://localhost:5174/support" />

  <AppDomains>
    <AppDomain>https://login.microsoftonline.com</AppDomain>
    <AppDomain>https://login.live.com</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <Requirements>
    <Sets DefaultMinVersion="1.3">
      <Set Name="Mailbox" MinVersion="1.3" />
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://localhost:5174" />
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteMailbox</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
  </Rule>

