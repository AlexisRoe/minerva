{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "email-parser",
  "projectType": "application",
  "sourceRoot": "apps/email-parser/src",
  "tags": ["lang:python"],
  "implicitDependencies": ["worker-core"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "uv run --package email-parser python -m email_parser"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/uv.lock", "{workspaceRoot}/pyproject.toml", "^default"],
      "options": {
        "command": "uv run pytest apps/email-parser"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/ruff.toml"],
      "options": {
        "command": "uv run ruff check apps/email-parser && uv run ruff format --check apps/email-parser"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/uv.lock", "{workspaceRoot}/pyproject.toml", "^default"],
      "options": {
        "command": "uv run mypy apps/email-parser/src"
      }
    }
  }
}
