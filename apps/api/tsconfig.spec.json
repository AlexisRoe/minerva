{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/vitest",
    "types": ["vitest/globals", "vitest/importMeta", "node", "vitest"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021"
