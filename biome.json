{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!**/dist", "!**/storybook-static", "!**/public", "!**/*.tsbuildinfo"]
  },
  "formatter": {
    "enabled": true,
    "useEditorconfig": true,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/backend/**", "shared/typescript-lib/**"],
      "javascript": {
        "parser": {
          "unsafeParameterDecoratorsEnabled": true
        }
      },
      "linter": {
        "domains": {
          "test": "recommended"
        },
        "rules": {
          "a11y": "off",
          "style": {
            "useImportType": "off",
            "noParameterProperties": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/frontend/**", "shared/ui-lib/**"],
      "linter": {
        "domains": {
          "react": "recommended",
          "test": "recommended"
        },
        "rules": {
          "style": {
            "useImportType": "error"
          }
        }
      }
    }
  ]
}
