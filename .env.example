# Copy to .env and adjust. NEVER commit .env — it is gitignored.
# Values below are local-development placeholders, not production secrets.

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=minerva_admin
POSTGRES_PASSWORD=change-me-admin
POSTGRES_DB=minerva
MINERVA_RW_PASSWORD=change-me-rw
MINERVA_RO_PASSWORD=change-me-ro

# Connection strings used by the API (rw = migrations + writes, ro = reads)
DATABASE_URL=postgresql://minerva_rw:change-me-rw@localhost:5432/minerva?schema=public
DATABASE_URL_RO=postgresql://minerva_ro:change-me-ro@localhost:5432/minerva?schema=public

# ── Valkey (Redis-compatible) ───────────────────────────────────────────────
VALKEY_PASSWORD=change-me-valkey
VALKEY_URL=redis://:change-me-valkey@localhost:6379/0

# ── S3 (LocalStack) ─────────────────────────────────────────────────────────
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_ENDPOINT=http://localhost:4566
S3_BUCKET=minerva-dev

# ── go-camo image proxy ─────────────────────────────────────────────────────
# Shared HMAC key: go-camo verifies URLs, the API signs them.
CAMO_HMAC_KEY=change-me-camo-hmac
CAMO_BASE_URL=http://localhost:8443

# ── API ─────────────────────────────────────────────────────────────────────
API_PORT=3000
API_TLS=true
TLS_CERT_PATH=infra/certs/localhost-cert.pem
TLS_KEY_PATH=infra/certs/localhost-key.pem
CORS_ORIGINS=https://localhost:5173,https://localhost:5174
SENTRY_DSN=

# ── Frontends (Vite exposes only VITE_* to the client) ──────────────────────
VITE_API_URL=https://localhost:3000
VITE_SENTRY_DSN=

# ── Python workers ──────────────────────────────────────────────────────────
EVENT_STREAM=minerva:events
WORKER_SENTRY_DSN=
