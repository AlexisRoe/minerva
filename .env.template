# -----------------------------------------------------------------
#  RUNTIME
# -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug


# -----------------------------------------------------------------
#  BACKEND - API
# -----------------------------------------------------------------

BE_API_SENTRY_DSN=
BE_API_SENTRY_TRACES_SAMPLE_RATE=0
# Profiles are cut from traced transactions, so this is a share of a share: it
# stays at 0 effectively as long as the traces rate above is 0.
BE_API_SENTRY_PROFILE_SESSION_SAMPLE_RATE=0
# Forwards console output to Sentry as structured logs. `true` or `false` only.
BE_API_SENTRY_ENABLE_LOGS=false

# The port the api answers on: `make api` serves it at https://api.localhost:<port>,
# with TLS terminated by Caddy using the mkcert pair from `make certs`. The
# NestJS process itself listens on a fixed 3000 inside its container, which
# nothing on the host can reach, so this is the only port worth configuring.
# 4301 is Storybook's — keep the api off it.
BE_API_PORT=4401

# V8 inspector of the dockerised api, published on 127.0.0.1 only.
BE_API_DEBUG_PORT=9229

# Browser origins allowed to call the api, comma separated. Entries are origins
# and nothing else — scheme, host and port, no trailing slash — because the
# check compares them to the `Origin` header character for character. Empty
# means "any origin", which is what a deployment without a browser client
# wants: a wrong allow-list looks like a bug in the frontend, not like
# configuration. The two below are the Vite dev servers, minerva-manager and
# minerva-button.
BE_API_CORS_ORIGINS=https://localhost:4201,https://localhost:4101

# Key that cookies marked `signed: true` are signed with, so the api can tell a
# cookie it issued from one the browser was talked into holding. Empty issues
# unsigned cookies only, which is fine until something worth signing exists;
# anything shorter than 32 characters fails the boot rather than pretending to
# protect. Fill this in with:
#
#   make secret VAR=BE_API_COOKIE_SECRET
#
# One per deployment — sharing it across stages means a cookie forged on one is
# valid on the others.
BE_API_COOKIE_SECRET=

# -----------------------------------------------------------------
#  BACKEND - QUEUE COORDINATOR
# -----------------------------------------------------------------

BE_QUEUE_SENTRY_DSN=
BE_QUEUE_SENTRY_TRACES_SAMPLE_RATE=0
# Profiles are cut from traced transactions, so this is a share of a share: it
# stays at 0 effectively as long as the traces rate above is 0.
BE_QUEUE_SENTRY_PROFILE_SESSION_SAMPLE_RATE=0

# The port the queue coordinator listens on *inside* the compose network. It is
# deliberately not published and Caddy has no site block for it: the coordinator
# accepts jobs from the api and the workers, all of which reach it over the
# network by service name. Nothing outside Docker is meant to talk to it, and a
# published port is an invitation to.
#
# The queue family is numbered from 4301 upwards — 4301 coordinator, 4302
# worker-email-parser, 4303 worker-email-screenshot. These are container ports,
# so they share the number space with nothing on the host: 4301 is also
# Storybook's host port and the two can never meet.
BE_QUEUE_PORT=4301

# V8 inspector of the dockerised coordinator, published on 127.0.0.1 only. A
# debugger runs on the host, so this one has to cross the boundary; the service
# port above does not.
BE_QUEUE_DEBUG_PORT=9230

# -----------------------------------------------------------------
#  FRONTEND - REPORTING BUTTON
# -----------------------------------------------------------------

APP_FE_RB_SENTRY_DSN=
APP_FE_RB_SENTRY_TRACES_SAMPLE_RATE=0
APP_FE_RB_PORT=4101
# Host the task pane is allowed to be served from, e.g. button.minerva.example.
# Empty means "do not pin a host" — the check is skipped, which is what local
# development and the Office dialog sandboxes rely on.
APP_FE_RB_APP_DOMAIN=
# Whether ?demo=true is honoured: the pane then runs on mock data and makes no
# outbound calls. Off unless the deployment exists to be demonstrated, so that
# nobody can reach the mock pane on a real one by editing the URL.
APP_FE_RB_ALLOW_DEMO=false
# Entra application (client) id the add-in signs in with. Must match the
# <Id> in manifest/manifest.local.xml; locally that is
# E81D4C4B-767E-4F5B-865F-87F816C0C953. Empty disables sign-in, which is what
# demo mode runs on.
APP_FE_RB_ENTRA_CLIENT_ID=
# How long start-up waits for Office.js to become ready, in milliseconds. Raise
# it where clients reach appsforoffice.microsoft.com through a slow proxy; past
# the deadline the pane shows the "cannot run here" screen. Empty means 5000.
APP_FE_RB_OFFICE_READY_TIMEOUT_MS=5000

# -----------------------------------------------------------------
#  FRONTEND - MANAGER
# -----------------------------------------------------------------

APP_FE_MANANGER_SENTRY_DSN=
APP_FE_MANANGER_SENTRY_TRACES_SAMPLE_RATE=0
APP_FE_MANANGER_PORT=4201


# -----------------------------------------------------------------
#  INFRASTRUCTURE - POSTGRES
# -----------------------------------------------------------------

# Published on 127.0.0.1 only, so psql and a GUI client can reach it while
# nothing on the network can. Change it if a Postgres of your own already owns
# 5432 on this machine.
INFRA_POSTGRES_PORT=5432
INFRA_POSTGRES_DB=minerva

# The owner role: it creates the schema and every table in it, and it is the
# only one migrations should ever run as. The two roles below are handed out to
# things that read and write rows but must not change their shape.
INFRA_POSTGRES_USER=minerva_app
#
#   make secret VAR=INFRA_POSTGRES_PASSWORD
INFRA_POSTGRES_PASSWORD=

# Read/write on every table the owner creates, now and later, but no DDL. This
# is what the api and the workers connect as.
#
#   make secret VAR=INFRA_POSTGRES_RW_PASSWORD
INFRA_POSTGRES_RW_PASSWORD=

# SELECT only, for a psql session, an ad-hoc query or a reporting tool. Its
# whole purpose is that a mistake made while holding it cannot write.
#
#   make secret VAR=INFRA_POSTGRES_RO_PASSWORD
INFRA_POSTGRES_RO_PASSWORD=

# The three roles are created by infra/postgres/init/01-roles.sql, which
# Postgres runs *once*, when the data directory is initialised. Changing a
# password here after the first `make infra` therefore changes nothing until the
# volume is dropped: `docker volume rm minerva_postgres-data`, or ALTER ROLE by
# hand.


# -----------------------------------------------------------------
#  INFRASTRUCTURE - VALKEY
# -----------------------------------------------------------------

# Published on 127.0.0.1 only, same reasoning as the Postgres port.
INFRA_VALKEY_PORT=6379

# Required, not optional: Valkey with no password accepts every client that can
# open the port, and `FLUSHALL` is one of the commands they get.
#
#   make secret VAR=INFRA_VALKEY_PASSWORD
INFRA_VALKEY_PASSWORD=

# Which logical database each concern uses. Convention only — Valkey does not
# enforce it — but it keeps a `FLUSHDB` while debugging the cache from taking
# the job queues with it. Pub/sub is *not* database-scoped, so the SSE channel
# names carry their own prefix instead; see infra/README.md.
INFRA_VALKEY_DB_QUEUE=0
INFRA_VALKEY_DB_CACHE=1
INFRA_VALKEY_DB_SSE=2


# -----------------------------------------------------------------
#  INFRASTRUCTURE - GARAGE (S3 OBJECT STORAGE)
# -----------------------------------------------------------------

# Garage serves two buckets: `assets` is public and reachable in a browser at
# https://assets.localhost:<web port>, `artifacts` is private and only reachable
# through signed S3 calls on the S3 API port.
INFRA_GARAGE_WEB_PORT=4501
INFRA_GARAGE_S3_PORT=3900

# Cluster secrets. Both must be 64 hexadecimal characters — Garage refuses to
# start otherwise — which is what `HEX=1` produces:
#
#   make secret HEX=1 VAR=INFRA_GARAGE_RPC_SECRET
#   make secret HEX=1 VAR=INFRA_GARAGE_ADMIN_TOKEN
INFRA_GARAGE_RPC_SECRET=
INFRA_GARAGE_ADMIN_TOKEN=

# The S3 credentials the backend signs its requests with. Set here rather than
# generated by Garage so that they survive a rebuild: a key Garage invents on
# first boot would have to be copied out of a container log into .env by hand,
# and again after every `docker volume rm`.
#
# The access key id must start with `GK` followed by 24 hexadecimal characters,
# and the secret must be 64 hexadecimal characters:
#
#   make secret HEX=1 VAR=INFRA_GARAGE_SECRET_ACCESS_KEY
#
# For the id, take the first 24 characters of another one and prefix `GK`.
INFRA_GARAGE_ACCESS_KEY_ID=
INFRA_GARAGE_SECRET_ACCESS_KEY=


# -----------------------------------------------------------------
#  INFRASTRUCTURE - CAMO (IMAGE PROXY)
# -----------------------------------------------------------------

# go-camo fetches remote images on the frontend's behalf, so a reported email's
# remote content is never loaded from the browser: no third party learns the
# reader's IP, and mixed content stops being a problem.
#
# @see https://github.com/cactus/go-camo
INFRA_CAMO_PORT=4502

# The HMAC key URLs are signed with. Whoever builds a camo URL and camo itself
# must hold the same one, and an unsigned or wrongly signed URL is refused —
# that is what keeps this from being an open proxy for anyone who finds it.
#
#   make secret HEX=1 VAR=INFRA_CAMO_KEY
INFRA_CAMO_KEY=


# -----------------------------------------------------------------
#  INFRASTRUCTURE - DOCKER
# -----------------------------------------------------------------

# Which stage of apps/backend/api/Dockerfile the api runs as. `development`
# bind-mounts the sources, rebuilds on change and opens the inspector;
# `production` runs the pruned runtime image instead.
MINERVA_API_TARGET=development

# Same for the queue coordinator.
MINERVA_QUEUE_TARGET=development

# Which stage of infra/docker/Dockerfile.caddy the reverse proxy runs as.
# `proxy` is Caddy on its own; `proxy-with-frontends` additionally builds the
# button and the manager and serves their bundles as static files. `make up`
# sets the latter, so this rarely needs touching by hand — building two Vite
# apps is not something `make infra` should pay for.
MINERVA_CADDY_TARGET=proxy
