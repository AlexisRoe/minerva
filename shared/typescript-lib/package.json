{
  "name": "@minerva/typescript-lib",
  "version": "0.1.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.build.esm.json && node ./scripts/write-dist-markers.mjs",
    "dev": "node ./scripts/write-dist-markers.mjs && (tsc -p tsconfig.build.json --watch & tsc -p tsconfig.build.esm.json --watch)",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "author": "Alexis Roehrling",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  }
}
