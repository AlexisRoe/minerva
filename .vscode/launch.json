{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@minerva/api", "run", "start:debug"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/apps/backend/api/dist/**/*.js", "!**/node_modules/**"]
    },
    {
      // For the api running in Docker (`make api`). The inspector is published
      // on 127.0.0.1 by infra/docker/docker-compose.yml; remoteRoot maps the
      // container's paths back onto the workspace so breakpoints bind.
      "type": "node",
      "request": "attach",
      "name": "Attach to api (Docker)",
      "address": "127.0.0.1",
      "port": 9229,
      "restart": true,
      "localRoot": "${workspaceFolder}/apps/backend/api",
      "remoteRoot": "/app/apps/backend/api",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug queue-coordinator",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@minerva/queue-coordinator", "run", "start:debug"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/apps/backend/queue-coordinator/dist/**/*.js", "!**/node_modules/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Vitest (current file)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["exec", "vitest", "run", "--no-file-parallelism", "${relativeFile}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Debug minerva-manager (browser)",
      "url": "https://localhost:4201",
      "webRoot": "${workspaceFolder}/apps/frontend/minerva-manager"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Debug minerva-button (browser)",
      "url": "https://localhost:4101",
      "webRoot": "${workspaceFolder}/apps/frontend/minerva-button"
    }
  ]
}
