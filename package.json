{
  "name": "minerva",
  "version": "0.2.0",
  "description": "",
  "license": "MIT",
  "author": "Alexis Roehrling",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=26",
    "pnpm": ">=11"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "husky": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @minerva/ui-lib build && pnpm -r --parallel dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "storybook": "pnpm --filter @minerva/ui-lib storybook",
    "build-storybook": "pnpm --filter @minerva/ui-lib build-storybook",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "husky"
  }
}
